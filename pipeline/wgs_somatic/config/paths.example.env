# Example environment variables for your project-specific deployment.
# Copy to paths.env and customize.

# Required project variables
export PROJECT_ROOT="/path/to/your/project"
export RAW_FASTQ_DIR="/path/to/raw_fastq"
export REFERENCE_DIR="/path/to/reference"
export OUTPUT_DIR="/path/to/output"

# Optional variables
export THREADS="16"
export MEMORY_GB="64"
export ORGANISM="human"
export GENOME="hg38"

# Legacy resource/tool locations (set once here, consumed by all stages)
export WGS_RESOURCES_DIR="/path/to/shared/resources"
export WGS_SOFTWARE_DIR="/path/to/shared/software"
export WGS_REFERENCE_GENOMES_DIR="${WGS_RESOURCES_DIR}/reference_genomes"
export WGS_GATK_PATH="${WGS_SOFTWARE_DIR}/gatk/gatk-4.2.3.0"
export WGS_SNPEFF_JAR="/path/to/snpEff.jar"
export WGS_SNPEFF_DATA_DIR="${WGS_RESOURCES_DIR}/snpEff_data/4.11/data"
export WGS_VEP_CACHE_DIR="/path/to/vep/cache"
export WGS_VARSCAN_JAR="/path/to/VarScan.v2.3.8.jar"
export WGS_FUNCOTATOR_DB_S="${WGS_RESOURCES_DIR}/funcotator_dataSources.v1.7.20200521s"
export WGS_FUNCOTATOR_DB_G="${WGS_RESOURCES_DIR}/funcotator_dataSources.v1.7.20200521g"
export WGS_ANNOVAR_DB="${WGS_RESOURCES_DIR}/humandb"

# Legacy compatibility (if needed by older scripts)
export LEGACY_PIPELINE_DIR="${PROJECT_ROOT}/somatic-mutation-analysis_bash_pipeline-main"
