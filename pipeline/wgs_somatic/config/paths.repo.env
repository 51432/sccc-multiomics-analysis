# Repository-local default for development/testing.
# For project deployments, copy paths.example.env to paths.env and customize.

export PROJECT_ROOT="/workspace/sccc-multiomics-analysis"
export RAW_FASTQ_DIR="${PROJECT_ROOT}/data/raw_fastq"
export REFERENCE_DIR="${PROJECT_ROOT}/data/reference"
export OUTPUT_DIR="${PROJECT_ROOT}/results/wgs_somatic"

export THREADS="8"
export MEMORY_GB="32"
export ORGANISM="human"
export GENOME="hg38"

# 所有资源路径在入口配置一次，stage 脚本直接复用这些变量。
export WGS_RESOURCES_DIR="/hpf/largeprojects/tabori/shared/resources"
export WGS_SOFTWARE_DIR="/hpf/largeprojects/tabori/shared/software"
export WGS_REFERENCE_GENOMES_DIR="${WGS_RESOURCES_DIR}/reference_genomes"
export WGS_GATK_PATH="${WGS_SOFTWARE_DIR}/gatk/gatk-4.2.3.0"
export WGS_SNPEFF_JAR="/hpf/tools/centos6/snpEff/4.11/snpEff.jar"
export WGS_SNPEFF_DATA_DIR="${WGS_RESOURCES_DIR}/snpEff_data/4.11/data"
export WGS_VEP_CACHE_DIR="/hpf/tools/centos6/vep/cache102"
export WGS_VARSCAN_JAR="/hpf/tools/centos6/varscan/2.3.8/VarScan.v2.3.8.jar"
export WGS_FUNCOTATOR_DB_S="${WGS_RESOURCES_DIR}/funcotator_dataSources.v1.7.20200521s"
export WGS_FUNCOTATOR_DB_G="${WGS_RESOURCES_DIR}/funcotator_dataSources.v1.7.20200521g"
export WGS_ANNOVAR_DB="${WGS_RESOURCES_DIR}/humandb"

export LEGACY_PIPELINE_DIR="${PROJECT_ROOT}/somatic-mutation-analysis_bash_pipeline-main"
